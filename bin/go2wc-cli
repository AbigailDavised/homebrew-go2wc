const ROUTES = [
  {
    "name": "Go2WC Home",
    "url": "https://go2wc.com/"
  },
  {
    "name": "Tokyo Station & Metro Accessible Restroom Guide",
    "url": "https://go2wc.com/city/tokyo"
  },
  {
    "name": "London Underground, Network Rail & RADAR Key Guide",
    "url": "https://go2wc.com/city/london"
  },
  {
    "name": "Paris Sanisettes (Free Street Units) & Metro WC Map",
    "url": "https://go2wc.com/city/paris"
  },
  {
    "name": "Kyoto Temple Districts & Transit Barrier-Free WC Map",
    "url": "https://go2wc.com/city/kyoto"
  },
  {
    "name": "Berlin City Toilet, Eurokey & Hauptbahnhof WC Guide",
    "url": "https://go2wc.com/city/berlin"
  }
];

const SPECS = [
  {
    "Region / Standard": "US ADA 2010 Section 604",
    "Wheelchair Turning Circle": ">= 60 in (1525 mm) diameter",
    "Clear Doorway Width": ">= 32 in (815 mm) clear",
    "Transit Access Model": "Municipal / commercial open",
    "Payment / Unlock Mechanism": "Free; customer PIN in dense cores"
  },
  {
    "Region / Standard": "ISO 21542 / EU EN 17210",
    "Wheelchair Turning Circle": ">= 1500 mm unobstructed",
    "Clear Doorway Width": ">= 850 - 900 mm clear",
    "Transit Access Model": "Paid concourse (Sanifair / 2theloo)",
    "Payment / Unlock Mechanism": "EUR 0.50 - 1.00 contactless / Eurokey"
  },
  {
    "Region / Standard": "UK BS 8300 / Changing Places",
    "Wheelchair Turning Circle": "1500 mm (3m x 4m w/ hoist)",
    "Clear Doorway Width": ">= 1000 mm outward/sliding",
    "Transit Access Model": "Network Rail major termini free",
    "Payment / Unlock Mechanism": "RADAR National Key Scheme (NKS)"
  },
  {
    "Region / Standard": "Japan Barrier-Free Dare-Demo",
    "Wheelchair Turning Circle": ">= 1500 - 2000 mm multi-use",
    "Clear Doorway Width": ">= 850 mm power sliding door",
    "Transit Access Model": "Inside JR / Metro IC fare-gate",
    "Payment / Unlock Mechanism": "Suica / Pasmo tap or station staff pass"
  }
];

const args = process.argv.slice(2);

if (args.includes('--version') || args.includes('-v')) {
  console.log('go2wc-cli v1.0.0 (https://go2wc.com)');
  process.exit(0);
}

if (args.includes('--routes')) {
  console.log(JSON.stringify({ domain: 'go2wc.com', endpoints: ROUTES }, null, 2));
  process.exit(0);
}

if (args.includes('--specs') || args.includes('--json')) {
  console.log(JSON.stringify({ domain: 'go2wc.com', benchmark: "International Accessible Restroom & Transit Station Access Standards", rows: SPECS }, null, 2));
  process.exit(0);
}

console.log([
  'Go2WC CLI (go2wc-cli v1.0.0)',
  'Global Transit Fare-Gate Restroom Access & ADA Wheelchair Clearance Spec CLI',
  'Homepage: https://go2wc.com',
  '',
  'Usage:',
  '  go2wc-cli --help       Show command overview and verified endpoints',
  '  go2wc-cli --version    Print CLI version',
  '  go2wc-cli --specs      Output domain technical specification matrix as JSON',
  '  go2wc-cli --routes     Output verified production URLs as JSON',
  '',
  'Verified Production Endpoints:',
  ...ROUTES.map((r) => '  - ' + r.name + ': ' + r.url),
].join('\n'));
